# ============================
# OS generated files
# ============================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================
# IDE - IntelliJ IDEA / JetBrains
# ============================
.idea/
*.iws
*.iml
*.ipr
/out/
atlassian-ide-plugin.xml

# ============================
# IDE - VS Code
# ============================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ============================
# IDE - Eclipse
# ============================
.classpath
.project
.settings/

# ============================
# Environment / Secrets
# ============================
.env
.env.*
!.env.example
!.env.*.example
**/runtime.env
*.p8
*.p12
*.jks
*.keystore
**/credentials.json
**/service-account*.json

# ============================
# Logs
# ============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================
# Backend - Java / Maven / Spring Boot
# ============================
backend/target/
backend/*.jar
backend/*.war
backend/*.class
backend/hs_err_pid*
backend/replay_pid*

# Spring profile config files may contain local/prod secrets.
# Keep the base application.yml committed because CI/CD and Docker builds need
# framework-safe defaults that are overridden by environment variables.
backend/src/main/resources/application-*.yml
!backend/src/main/resources/application-local.yml

# Maven wrapper jar (generated)
backend/.mvn/wrapper/maven-wrapper.jar

# Spring Boot shell log
backend/spring-shell.log

# Uploaded files (user-generated content)
backend/uploads/
infra/aws-low-cost/migration.env
infra/aws-low-cost/secrets/

# Large data files used only for seeding (not needed in VCS)
docs/wineries/
docs/wines/
docs/dump*.sql
# Generated personal documents and their local generator/runtime links.
/outputs/

# Local planning / working notes
planning/*.md
planning/ISSUE_124_*.json
planning/ISSUE_127_*.json
planning/issue-127-*.mjs
planning/Issue127*.java
planning/admin-*-122.mjs
planning/issue-124-api-acceptance.mjs
planning/scan-september-*.mjs
planning/ScanSeptember*.java
planning/SCAN_SEPTEMBER_*.json*
docs/PLAN_DE_GESTION_DEL_PROYECTO.md

# Local agent tooling state. AGENTS.md and .engram/config.json stay versioned.
.atl/
odd/
.claude/settings.local.json

# Local audit/review artifacts. Canonical architecture, product and release
# documentation remains versioned; these patterns only cover ad-hoc reports
# that have previously been committed and later removed.
**/*_AUDIT*.md
**/*-audit*.md
**/*_REVIEW_????-??-??.md
**/*-review-????-??-??.md

# Benchmark and acceptance run reports are reproducible execution artifacts.
# Canonical docs define procedures and gates, not dated run output.
artifacts/acceptance/**
docs/WINE_LABEL_SCAN_BENCHMARK_*.json
docs/WINE_LABEL_SCAN_ACCEPTANCE_*.md
docs/WINE_LABEL_SCAN_ACCEPTANCE_*.json

