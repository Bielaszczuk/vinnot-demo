# =============================================================================
# Vinnot Mobile — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with EXPO_PUBLIC_ are embedded at build time by Metro
# and exposed to client-side code. Non-prefixed vars are build-time only.
#
# LOCAL DEVELOPMENT QUICK START:
# 1. Copy this file: cp .env.example .env.local
# 2. Start backend from /vinnot/backend:
#      mvn spring-boot:run -Dspring-boot.run.profiles=local
#    OR use docker-compose from /vinnot/infra:
#      docker-compose up -d
# 3. Start Expo: npm start
#
# Device / emulator notes:
#   - iOS Simulator:     EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
#   - Android Emulator:  EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
#   - Physical device:   EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8080/api
#
# Default seeded users (local only):
#   - admin@vinnot.local / Vinnot123!   (ADMIN)
#   - partner@vinnot.local / Vinnot123! (PARTNER)
#   - user@vinnot.local / Vinnot123!    (USER)
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for the backend API (no trailing slash).
# Dev cloud backend: https://api-dev.vinnot.com/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Environment identifier: development | staging | production
# Controls app.config.ts profile selection (bundle IDs, API URLs, app name)
EXPO_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Online event payments (Mercado Pago). Enabled only when "true".
EXPO_PUBLIC_EVENT_PAYMENTS_ENABLED=false
# Sandbox payments outside production builds. Ignored when EXPO_ENV=production.
EXPO_PUBLIC_EVENT_PAYMENTS_SANDBOX=false

# Mock API mode, development builds only (read by shared/config/featureFlags.ts).
# Mobile has no MSW service worker; keep false unless a mock adapter is wired in.
EXPO_PUBLIC_MOCK_API=false

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Google Maps keys for react-native-maps (winery/event maps).
# Get them at: https://console.cloud.google.com/apis/credentials
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY is the fallback when a platform key is empty.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# SHA-1 of the Android signing certificate the Android Maps key is restricted to.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=

# Social authentication public identifiers. Keep provider secrets server-side.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=162159837919-ojvdkl55fsaovve22saral06m9a4rm1o.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=162159837919-5m0ojpq0ut7uct3n1s8sucgase0rqftn.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.162159837919-5m0ojpq0ut7uct3n1s8sucgase0rqftn
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=162159837919-k1pmtt1hq04c070a6us3uh4hs1iau0bh.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=984338657968690
# Facebook login is on when an app ID is set; set "false" to hide it.
EXPO_PUBLIC_FACEBOOK_LOGIN_ENABLED=true
# Build-time native Facebook SDK configuration; store as a sensitive EAS variable.
# FACEBOOK_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# Build Configuration (EAS Build)
# -----------------------------------------------------------------------------
# These are used by app.config.ts and eas.json, not by runtime code.
# Set via EAS Build environment or CI/CD secrets — do NOT commit real values.
# EAS_PROJECT_ID is generated by `eas init` and should be provided by EAS env
# or local shell when needed. Do not leave placeholder IDs in app.config.ts.
# EAS_PROJECT_ID=
# EXPO_OWNER=vinnot
#
# EXPO_PUBLIC_API_BASE_URL=https://api.vinnot.com/api  ← production override
