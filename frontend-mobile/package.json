{
  "name": "vinnot-frontend-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "expo",
        "expo-build-properties",
        "expo-dev-client",
        "expo-router",
        "expo-updates",
        "react-native-screens",
        "expo-constants",
        "expo-linking",
        "expo-notifications",
        "expo-splash-screen",
        "jest-expo",
        "react-native-safe-area-context"
      ]
    }
  },
  "scripts": {
    "postinstall": "node ./scripts/apply-security-backports.mjs",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:device": "node ./scripts/start-physical-device.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:native": "node ./scripts/run-ios-simulator.mjs",
    "ios:device": "expo prebuild --platform ios --clean && expo run:ios --device",
    "android:native": "expo run:android",
    "web": "expo start --web",
    "start:tunnel": "expo start --tunnel",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "preflight:ios:native": "node ./scripts/verify-native-ios-build.mjs",
    "test:release-config": "node --test ./scripts/test/*.test.mjs",
    "eas:update:preview": "node ./scripts/publish-preview-update.mjs",
    "eas:update:production": "node ./scripts/publish-production-update.mjs",
    "eas:build:dev": "npm run preflight:ios:native && eas build --profile development",
    "eas:build:preview": "npm run preflight:ios:native && eas build --profile preview",
    "eas:build:production": "npm run preflight:ios:native && eas build --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^6.0.0",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@reduxjs/toolkit": "^2.13.0",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "axios": "^1.20.0",
    "base64-js": "^1.5.1",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "i18next": "^26.5.10",
    "intl-pluralrules": "^2.0.1",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.8",
    "react-native": "0.88.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "30.0.0",
    "@types/jpeg-js": "^0.3.7",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/metro-config": {
      "postcss": "8.5.28"
    },
    "@expo/cli": {
      "zod": "$zod"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/scripts/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-redux|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@gorhom|@shopify|immer|standard-navigation)"
    ],
    "collectCoverageFrom": [
      "src/domain/event/eventEditor.ts",
      "src/domain/event/eventDraft.ts",
      "src/domain/user/contactPhone.ts",
      "src/presentation/features/event/useEventRegistrationForm.ts",
      "src/domain/navigation/nativeIntent.ts",
      "src/domain/sharing/*.ts",
      "src/presentation/hooks/useReauthentication.ts",
      "src/domain/public/*.ts",
      "src/domain/legal/*.ts",
      "src/presentation/hooks/useLegalAgreement.ts",
      "src/presentation/hooks/usePublicDocument.ts",
      "src/presentation/feedback/illustratedState.ts",
      "src/presentation/hooks/useSupportForm.ts",
      "src/presentation/hooks/useSupportReference.ts",
      "src/infrastructure/support/clipboard.ts",
      "src/presentation/hooks/useRetryDeadline.ts",
      "src/infrastructure/api/retryAfter.ts",
      "src/application/operations/types.ts",
      "src/application/services/*.service.ts",
      "src/domain/**/*.mappers*.ts",
      "src/domain/**/*.validators.ts",
      "src/domain/wine/wine.quick-info.ts",
      "src/presentation/features/wine/sensoryBar.ts",
      "!src/**/*.test.ts",
      "!src/domain/wine/wine.mappers.types.ts",
      "!src/domain/wine/wine.mappers.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 60,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
