# =============================================================================
# Vinnot Frontend React — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with VITE_ are exposed to the client-side code.
#
# LOCAL DEVELOPMENT QUICK START:
# 1. Copy this file: cp .env.example .env.local
# 2. Start backend from /vinnot/backend:
#      mvn spring-boot:run -Dspring-boot.run.profiles=local
#    OR use docker-compose from /vinnot/infra:
#      docker-compose up -d
# 3. Start frontend: npm run dev
# 4. Open http://localhost:3000
#
# For MOCK API mode (no backend needed):
# 1. Copy this file: cp .env.example .env.local
# 2. Set VITE_MOCK_API=true
# 3. Start: npm run dev:mock
#
# Default seeded users (local/mock only):
#   - admin@vinnot.local / Vinnot123! (ADMIN)
#   - partner@vinnot.local / Vinnot123! (PARTNER)
#   - user@vinnot.local / Vinnot123! (USER)
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for the backend API
# For local development with backend running on port 8080 (proxied via Vite):
VITE_API_BASE_URL=/api

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Mock API (Development Only)
# -----------------------------------------------------------------------------
# Set to 'true' to enable MSW mock service worker for local development
# without a running backend. Should be 'false' in production.
VITE_MOCK_API=false

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Environment identifier: development | production (ci/test in automation).
# Any other value fails the build: sharing link associations are provisioned per environment.
VITE_APP_ENV=development

# Optional override of the published app listings. Empty or invalid values
# fall back to the live store pages (PUBLISHED_APP_LISTINGS in appDownloads.ts).
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# Base path for the app (use '/' for root, '/app/' for subdirectory)
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable social login (Google, Apple, Facebook); set "false" to hide all buttons
VITE_FEATURE_SOCIAL_LOGIN=true

# Facebook login is on when an app ID is set; set "false" to hide only Facebook
VITE_FEATURE_FACEBOOK_LOGIN=true

# Online event payments (Mercado Pago). Enabled only when "true".
VITE_EVENT_PAYMENTS_ENABLED=false
# Sandbox payments outside production builds. Ignored when VITE_APP_ENV=production.
VITE_EVENT_PAYMENTS_SANDBOX=false

# OAuth public client identifiers. Provider secrets belong only in the backend.
VITE_GOOGLE_OAUTH_CLIENT_ID=162159837919-ojvdkl55fsaovve22saral06m9a4rm1o.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:3000/login
VITE_FACEBOOK_APP_ID=984338657968690

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Google Maps API key for location features (events, wineries, routes)
# Get yours at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to generate source maps in production
VITE_GENERATE_SOURCEMAP=false

# Development Android app-link certificate fingerprint (SHA-256) published in
# assetlinks.json for non-production builds. Leave empty locally.
VITE_DEV_ANDROID_SHA256=
