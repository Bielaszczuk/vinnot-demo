# =============================================================================
# vinnot Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# PostgreSQL Configuration
POSTGRES_DB=vinnot
POSTGRES_USER=vinnot
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8080

# JWT Configuration (minimum 32 characters for secret)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ISSUER=vinnot-backend
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Account lifecycle and transactional email
APP_AUTH_FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=60
# Use "log" locally. Use "ses" in AWS after verifying the sender identity.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@vinnot.com
EMAIL_SES_REGION=us-east-1

# Social identity providers
# Comma-separated OAuth client IDs accepted as token audiences.
GOOGLE_OAUTH_AUDIENCES=162159837919-ojvdkl55fsaovve22saral06m9a4rm1o.apps.googleusercontent.com,162159837919-5m0ojpq0ut7uct3n1s8sucgase0rqftn.apps.googleusercontent.com,162159837919-k1pmtt1hq04c070a6us3uh4hs1iau0bh.apps.googleusercontent.com
APPLE_OAUTH_AUDIENCES=
FACEBOOK_APP_ID=984338657968690
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

# Frontend Configuration (optional)
FRONTEND_PORT=3000

# =============================================================================
# AI Configuration (Optional - for AI-powered features)
# =============================================================================
# Provider: 'mock' for development without API costs, 'openai' for real AI
AI_PROVIDER=mock
AI_ENABLED=true

# OpenAI API Key (required if AI_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-6-luna

# =============================================================================
# Google Maps Configuration (Optional - for route maps and geocoding)
# =============================================================================
# Enable/disable maps features
GOOGLE_MAPS_ENABLED=true

# Google Maps API Key (required for real maps)
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
