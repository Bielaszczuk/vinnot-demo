{
	email no-reply@vinnot.com
	admin off

	# Cloudflare proxies the API. Only its edge may name the client: Caddy reads
	# CF-Connecting-IP from these peers and ignores it from anyone else, so {client_ip}
	# is the TCP peer for direct connections. Ranges fetched 2026-10-29 from
	# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6; refresh
	# them together with production-stack.json when Cloudflare changes the list.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$VINNOT_API_HOST:api-dev.vinnot.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy backend:8080 {
		# RFC 7239 is client-controlled; Spring must only see Caddy's normalized X-Forwarded-*.
		header_up -Forwarded
		# One X-Forwarded-For entry: the resolved client, never the edge or a client-sent list.
		header_up X-Forwarded-For {client_ip}
		# Trusted peers would otherwise pass client-sent host and scheme through. Caddy logs
		# these two as "unnecessary"; that only holds for untrusted peers, so keep them.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /api/actuator/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
