# Generated on the host from AWS Secrets Manager. Never commit runtime.env.
DB_PASSWORD=
JWT_SECRET=
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
FACEBOOK_APP_SECRET=
APPLE_PRIVATE_KEY=

# Optional rollout values; the host imports these if present in the runtime secret.
# Publish V21 and compatible clients before enabling server-wide enforcement.
LEGAL_TERMS_VERSION=2026-10-29.1
LEGAL_ENFORCE_ACCEPTANCE=false

# R2 user uploads (opt-in; catalogue objects are shared independently).
APP_STORAGE_PROVIDER=s3
APP_STORAGE_R2_ACCOUNT_ID=
APP_STORAGE_R2_ACCESS_KEY_ID=
APP_STORAGE_R2_SECRET_ACCESS_KEY=
APP_STORAGE_R2_BUCKET=
APP_STORAGE_R2_WRITES_ENABLED=true
# Monthly R2 byte allowance for rendered social media (slides and illustrations), 1 GiB by default.
APP_STORAGE_R2_SOCIAL_MAX_MONTHLY_BYTES=1073741824

# Event payments stay disabled until the environment's credentials and acceptance checks are complete.
# LIVE_PILOT additionally requires an explicitly allowed seller and enforces ARS 50 maximum per checkout.
EVENT_PAYMENTS_ENABLED=false
EVENT_PAYMENTS_CHECKOUT_ENABLED=false
EVENT_PAYMENTS_SETTLEMENT_ENABLED=false
EVENT_PAYMENTS_ENVIRONMENT=SANDBOX
EVENT_PAYMENTS_CLIENT_ID=
EVENT_PAYMENTS_CLIENT_SECRET=
EVENT_PAYMENTS_ENCRYPTION_KEY=
EVENT_PAYMENTS_WEBHOOK_SECRET=
EVENT_PAYMENTS_PLATFORM_OWNER_ID=
EVENT_PAYMENTS_PILOT_SELLER_ID=
EVENT_PAYMENTS_REDIRECT_URI=https://dev.vinnot.com/partner/payments/callback
EVENT_PAYMENTS_CHECKOUT_RETURN_URI=https://dev.vinnot.com/payments/return
EVENT_PAYMENTS_NOTIFICATION_URI=https://api-dev.vinnot.com/api/payments/mercadopago/webhooks
# The production Compose overlay pins the three destinations to vinnot.com/api.vinnot.com.
# Never copy OAuth credentials or credential encryption keys between environments.
# One Mercado Pago application shares its webhook signing secret; its per-checkout
# notification_url routes each attempt to the environment that created it.

# Social media agent (#489). Set MARKETING_ENABLED=false to stop the Monday planner and the copy retry
# without removing the admin page; the planner can still run on demand from the admin page.
MARKETING_ENABLED=true
MARKETING_PLANNER_CRON=0 0 9 * * MON
MARKETING_PLANNER_ZONE=America/Argentina/Buenos_Aires
# #513: rotating posts on these weekdays at this time; wine days at their own time on their day; at most one post a
# day and this many a week (priority 1 wine days always post).
MARKETING_PLANNER_SLOT_DAYS=TUESDAY,WEDNESDAY,THURSDAY
MARKETING_PLANNER_SLOT_TIME=12:30
MARKETING_PLANNER_WINE_DAY_TIME=09:30
MARKETING_PLANNER_MAX_POSTS_PER_WEEK=4
MARKETING_PLANNER_WINDOW_DAYS=14
MARKETING_GENERATION_INITIAL_DELAY_MS=300000
MARKETING_GENERATION_DELAY_MS=1800000
# #510: daily metrics of the publications (06:00 in the planner zone) and the planner's pillar weighting window.
MARKETING_METRICS_ENABLED=false
MARKETING_METRICS_CRON=0 0 6 * * *
MARKETING_METRICS_WINDOW_DAYS=30
MARKETING_WEIGHTING_WINDOW_DAYS=90
# #510: approval by the system of pending posts of pillars with auto-approval on, this long before their slot.
MARKETING_AUTO_APPROVE_ENABLED=false
MARKETING_AUTO_APPROVE_LEAD=24h
MARKETING_AUTO_APPROVE_DELAY_MS=900000

# Social network adapters (#510). Hosts and Graph versions only, never tokens. Poll settings bound how long one
# publish waits for Instagram/Threads/TikTok to process the images before the outbox retries it later.
MARKETING_NETWORKS_CONNECT_TIMEOUT=10s
MARKETING_NETWORKS_REQUEST_TIMEOUT=30s
MARKETING_NETWORKS_POLL_INTERVAL=15s
MARKETING_NETWORKS_POLL_TIMEOUT=5m
MARKETING_META_GRAPH_VERSION=v27.0
MARKETING_THREADS_VERSION=v1.0
MARKETING_INSTAGRAM_METRICS=views,reach,likes,comments,saved,shares
MARKETING_INSTAGRAM_ALT_TEXT=true

# Social publishing (#510): approved posts publish themselves at their slot. Everything is off by default; enable
# publishing and then each network once its account is configured. TikTok stays MEDIA_UPLOAD (inbox draft) until
# TikTok's audit approves DIRECT_POST.
MARKETING_PUBLISHING_ENABLED=false
MARKETING_PUBLISHING_DELAY_MS=300000
MARKETING_PUBLISHING_MEDIA_GRACE=PT6H
MARKETING_PUBLISHING_INSTAGRAM_ENABLED=false
MARKETING_PUBLISHING_FACEBOOK_ENABLED=false
MARKETING_PUBLISHING_THREADS_ENABLED=false
MARKETING_PUBLISHING_TIKTOK_ENABLED=false
MARKETING_PUBLISHING_TIKTOK_MODE=MEDIA_UPLOAD
# #513: a network may wait until this local time of the post's day (empty = the post time); publish now ignores it.
MARKETING_PUBLISHING_INSTAGRAM_NOT_BEFORE=
MARKETING_PUBLISHING_FACEBOOK_NOT_BEFORE=
MARKETING_PUBLISHING_THREADS_NOT_BEFORE=
MARKETING_PUBLISHING_TIKTOK_NOT_BEFORE=19:30
# #516: TikTok inbox drafts the creator posted become published; checked every 15 minutes for 14 days, 20 per run.
MARKETING_PUBLISHING_DRAFT_SYNC_DELAY_MS=900000
MARKETING_PUBLISHING_DRAFT_SYNC_WINDOW_DAYS=14
MARKETING_PUBLISHING_DRAFT_SYNC_MAX_PER_SWEEP=20
# Publishing agent network connections (#510). Leave empty until each network is set up; never commit real values.
# Token encryption key for Threads/TikTok: base64 of 32 random bytes (openssl rand -base64 32).
MARKETING_ACCOUNTS_ENCRYPTION_KEY=
# Meta business system-user token (Instagram + Facebook Page) and the account ids.
MARKETING_META_ACCESS_TOKEN=
MARKETING_META_INSTAGRAM_USER_ID=
MARKETING_META_PAGE_ID=
MARKETING_META_PAGE_ACCESS_TOKEN=
# Threads and TikTok apps; redirect URIs: https://<api host>/api/public/social-accounts/{threads|tiktok}/callback
MARKETING_THREADS_CLIENT_ID=
MARKETING_THREADS_CLIENT_SECRET=
MARKETING_THREADS_REDIRECT_URI=
MARKETING_TIKTOK_CLIENT_KEY=
MARKETING_TIKTOK_CLIENT_SECRET=
MARKETING_TIKTOK_REDIRECT_URI=

# Social media illustrations (#492): OpenAI images edits with the app illustrations as style references.
# Off by default; when off, in mock mode or over budget, posts use their bundled pillar vignette.
# Each image attempt reserves AI_IMAGES_MAX_COST_USD against AI_MONTHLY_LIMIT_USD / AI_DAILY_LIMIT_USD.
AI_IMAGES_ENABLED=false
AI_IMAGES_MODEL=gpt-image-1
AI_IMAGES_QUALITY=medium
AI_IMAGES_SIZE=1024x1536
AI_IMAGES_MAX_COST_USD=0.25
AI_IMAGES_TIMEOUT=110s
AI_IMAGES_MAX_ATTEMPTS=2
AI_IMAGES_INITIAL_BACKOFF_MS=500
OPENAI_IMAGES_URL=https://api.openai.com/v1/images/edits
