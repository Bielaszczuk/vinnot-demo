# Copy to .env and replace every placeholder on your own computer.
# PostgreSQL must already exist; use a SELECT-only role.
DATABASE_URL=postgresql://readonly_user:replace-local-password@127.0.0.1:5432/wines
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET=replace-bucket-name
R2_ACCESS_KEY_ID=replace-access-key-id
R2_SECRET_ACCESS_KEY=replace-secret-access-key
# Public custom domain or enabled public bucket URL, not the private S3 endpoint.
R2_PUBLIC_BASE_URL=https://images.example.invalid
WEBP_QUALITY=85
